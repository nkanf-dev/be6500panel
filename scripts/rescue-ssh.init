#!/bin/sh /etc/rc.common
# Owned LAN rescue. 2222 + loopback are the acceptance path; 22 is optional.
START=95
STOP=10
USE_PROCD=1
start_service() {
    local LAN RESCUE_LIBRARY_ONLY
    RESCUE_LIBRARY_ONLY=1
    . /data/ssh/rescue-bootstrap.sh
    rescue_validate
    LAN=$(rescue_lan) || return 1
    procd_open_instance lan-2222
    procd_set_param command /data/ssh/bin/dropbear -F -s -j -k \
        -r /data/ssh/dropbear_rsa_host_key \
        -P /var/run/be6500-rescue-2222.pid \
        -p "$LAN:2222" -p 127.0.0.1:2222 -K 300 -T 3
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
    # Do not stop/reconfigure a factory SSH daemon occupying port 22.
    if ! rescue_port_busy 22; then
        procd_open_instance lan-22
        procd_set_param command /data/ssh/bin/dropbear -F -s -j -k \
            -r /data/ssh/dropbear_rsa_host_key \
            -P /var/run/be6500-rescue-22.pid -p "$LAN:22" -K 300 -T 3
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 0
        procd_set_param stderr 1
        procd_close_instance
    fi
}
